###
# BSC MareNostrum cluster settings
###

CLUSTER_JOB_SCHEDULER=SLURM

# Isaac Sim cache on scratch (must end on docker-isaac-sim)
CLUSTER_ISAAC_SIM_CACHE_DIR=/gpfs/scratch/ehpc565/docker-isaac-sim

# IsaacLab directory on cluster (must end on isaaclab)
CLUSTER_ISAACLAB_DIR=/gpfs/scratch/ehpc565/isaaclab

# BSC login node
CLUSTER_LOGIN=tum634073@alogin1.bsc.es

# Directory on cluster where .sif/.tar container files live
CLUSTER_SIF_PATH=/gpfs/scratch/ehpc565/containers

# IsaacLabEureka root on cluster (used by run_singularity_eureka.sh)
CLUSTER_EUREKA_DIR=/gpfs/scratch/ehpc565/IsaacLabEureka

REMOVE_CODE_COPY_AFTER_JOB=false

# Python script to run inside the container
CLUSTER_PYTHON_EXECUTABLE=scripts/reinforcement_learning/rsl_rl/train.py
